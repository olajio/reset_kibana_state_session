{
  "name": "Reset Kibana state:storeInSessionStorage",
  "description": "Choose deployments and whether to preview (dry-run) or apply (execute).",
  "spec": [
    {
      "question_name": "Deployments",
      "question_description": "Tick 'all' for every deployment in deployments.txt, or tick individual deployments. Deployments ticked alongside 'all' are already included.",
      "required": true,
      "type": "multiselect",
      "variable": "deployments",
      "min": null,
      "max": null,
      "default": "",
      "choices": [
        "all",
        "cdm-fed",
        "cdm-va",
        "cdm-dos",
        "cdm-tva",
        "cdm-abmc",
        "cdm-nasa"
      ],
      "new_question": true
    },
    {
      "question_name": "Exclude deployments",
      "question_description": "Optional. Deployments to leave out, e.g. when 'all' is ticked.",
      "required": false,
      "type": "multiselect",
      "variable": "exclude_deployments",
      "min": null,
      "max": null,
      "default": "",
      "choices": [
        "cdm-fed",
        "cdm-va",
        "cdm-dos",
        "cdm-tva",
        "cdm-abmc",
        "cdm-nasa"
      ],
      "new_question": true
    },
    {
      "question_name": "Run mode",
      "question_description": "dry-run reports what would change and changes nothing. execute changes the setting.",
      "required": true,
      "type": "multiplechoice",
      "variable": "run_mode",
      "min": null,
      "max": null,
      "default": "dry-run",
      "choices": [
        "dry-run",
        "execute"
      ],
      "new_question": true
    },
    {
      "question_name": "Value to write",
      "question_description": "set-false writes an explicit false (visible in Advanced Settings). reset-to-default removes the override, like the UI's Reset to default. Both leave the setting false.",
      "required": true,
      "type": "multiplechoice",
      "variable": "value_mode",
      "min": null,
      "max": null,
      "default": "set-false",
      "choices": [
        "set-false",
        "reset-to-default"
      ],
      "new_question": true
    },
    {
      "question_name": "Spaces",
      "question_description": "Optional. Only these Kibana space IDs, separated by commas (e.g. default,admin or default, admin). Leave blank for every space.",
      "required": false,
      "type": "text",
      "variable": "spaces",
      "min": 0,
      "max": 2048,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Skip spaces",
      "question_description": "Optional. Kibana space IDs to leave alone, separated by commas (e.g. default,admin,infra or default, admin, infra). Leave blank to skip none.",
      "required": false,
      "type": "text",
      "variable": "exclude_spaces",
      "min": 0,
      "max": 2048,
      "default": "",
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Parallel jobs",
      "question_description": "How many copies of the script run on the appserver at once. Deployments are split evenly between them.",
      "required": true,
      "type": "integer",
      "variable": "parallel_jobs",
      "min": 1,
      "max": 50,
      "default": 10,
      "choices": "",
      "new_question": true
    },
    {
      "question_name": "Verify Kibana TLS",
      "question_description": "Keep true. false skips certificate checks for Kibana (last resort).",
      "required": true,
      "type": "multiplechoice",
      "variable": "verify_ssl",
      "min": null,
      "max": null,
      "default": "true",
      "choices": [
        "true",
        "false"
      ],
      "new_question": true
    },
    {
      "question_name": "Verbose logging",
      "question_description": "true logs every Kibana API request (URLs only, never credentials).",
      "required": true,
      "type": "multiplechoice",
      "variable": "verbose",
      "min": null,
      "max": null,
      "default": "false",
      "choices": [
        "false",
        "true"
      ],
      "new_question": true
    }
  ]
}
